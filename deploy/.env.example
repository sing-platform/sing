# Copie para .env e ajuste. O .env real NAO e versionado.
#   cp .env.example .env

# ---- portas expostas no host ----
TRAEFIK_HTTP_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081
CORE_DB_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8180
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090

# ---- banco do core ----
CORE_DB_NAME=sing_core
CORE_DB_USER=sing
CORE_DB_PASSWORD=trocar-esta-senha

# ---- mensageria ----
RABBITMQ_USER=sing
RABBITMQ_PASSWORD=trocar-esta-senha

# ---- storage (MinIO) ----
MINIO_USER=singadmin
MINIO_PASSWORD=trocar-esta-senha-min-8-chars

# ---- identity ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=trocar-esta-senha

# ---- aplicacao ----
# Gere com:  openssl rand -hex 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL_ROOT=INFO

# ---- documents (E2) ----
DOCS_DB_NAME=sing_documents
DOCS_DB_USER=sing
DOCS_DB_PASSWORD=trocar-esta-senha
DOCS_DB_PORT=5433
DOCS_BUCKET=sing-documents
EVENTS_EXCHANGE=sing.events

# ---- matricula criada (N2) ----
# Dois Mongos: comprovante e notificacao nao compartilham credencial.
MONGO_DOCUMENTS_USER=documents
MONGO_DOCUMENTS_PASSWORD=trocar-esta-senha
MONGO_DOCUMENTS_PORT=27017
MONGO_COMMUNICATION_USER=communication
MONGO_COMMUNICATION_PASSWORD=trocar-esta-senha
MONGO_COMMUNICATION_PORT=27018
DOCUMENTS_COMPROVANTE_MAX_BYTES=1048576
# O finance (.NET) nao esta neste compose. Enquanto a URL nao responder, a cobranca fica pendente.
N2_FINANCE_BASE_URL=http://finance:8080
N2_COBRANCA_VALOR_CENTAVOS=15000
N2_COBRANCA_PRAZO_DIAS=10
N2_RETRY_INTERVALO=30s
N2_RETRY_LIMITE=10
N2_CLAIM_SEGUNDOS=60
